<% if decklist.present? %>
  <span class="icon has-tooltip-left has-tooltip-info"
        id="<%= decklist_id(decklist, pid) %>"
        data-tooltip="<%= decklist_lines(decklist) %>"
        style="cursor:auto; color:<%= decklist_check_color(decklist) %>"><i class="fas fa-<%= decklist_check_symbol(decklist) %>"></i></span>
<% else %>
  <span id="<%= decklist_id(decklist, pid) %>">-</span>
<% end %>
